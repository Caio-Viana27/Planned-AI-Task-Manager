# Copy to .env and fill in real values. Never commit .env.

# Postgres superuser, used by the database container and the API.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# JDBC URL the API uses. The host is the compose service name.
TASK_MANAGER_DB_URL=jdbc:postgresql://task-manager-db:5432/task_manager_db

# AI vendor and model, used through Spring AI (wave 3 plan, D10).
# Spring AI chat provider id. Optional: defaults to google-genai (Gemini), the only one
# built in today. Other providers need their starter added first (see D10).
# AI_PROVIDER=google-genai
# Model name for the active provider, e.g. gemini-2.5-flash.
AI_MODEL=gemini-2.5-flash
# API key for providers that need one (Gemini).
AI_API_KEY=your-gemini-api-key
# Endpoint for self-hosted providers such as Ollama. Optional, unused by Gemini.
# AI_BASE_URL=http://host.docker.internal:11434

# Secret for signing JWTs (HS256). Use at least 32 random bytes, e.g. `openssl rand -base64 32`.
JWT_SECRET=change-me-to-a-random-32-byte-secret

# IANA time zone the API uses for "today" (due dates, overdue job).
APP_TIMEZONE=America/Sao_Paulo

# Base URL the UI calls the API with. Optional: defaults to /api, which the Vite dev
# proxy (npm run dev) and nginx (Docker) forward to the API. Vite reads it at build
# time from the shell or AI-Task-Manager-UI/.env, not from this file or compose.
# VITE_API_URL=/api
